# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

NEON_PROJECT_ID="your-neon-project-id"

# ─── Auth / Encryption ────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL=https://your-app.vercel.app

# ─── AI APIs ──────────────────────────────────────────────────────────────────
# DeepSeek V4 Pro — text generation, script writing, quality scoring, music selection
DEEPSEEK_API_KEY="sk-your-deepseek-key"

# Cloudflare Workers AI — FLUX.1 [schnell] image generation (slides + thumbnails)
CLOUDFLARE_AI_API_TOKEN="cfut-your-cloudflare-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# F5-TTS on Modal — voice-cloned narration
# After deploying modal/tts.py, copy the endpoint URL here.
F5_TTS_URL="https://<your-workspace>--f5-tts-f5ttsmodel-generate-speech.modal.run"
# Must match the F5_TTS_API_KEY secret you set in Modal (modal secret create f5-tts-secrets F5_TTS_API_KEY=...)
F5_TTS_API_KEY="your-f5-tts-api-key"

# ACE-Step BGM on Modal — instrumental music generation
# After deploying modal/bgm.py, copy the endpoint URL here.
ACE_STEP_BGM_URL="https://<workspace>--bgm-generator-bgmgenerator-generate-bgm.modal.run"
ACE_STEP_API_KEY="your-bgm-api-key"

# ─── Inngest ──────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_DEV=1

# ─── Pipeline Config ──────────────────────────────────────────────────────────
CRON_SECRET="your-cron-secret"
ACCOUNT_ID=tech_shots
MODAL_RENDER_URL="https://username--slideshow-render-trigger-render.modal.run"

# ─── Debug ────────────────────────────────────────────────────────────────────
# DEBUG_MODE=true
